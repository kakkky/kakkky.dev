package components

import "github.com/kakkky/hotwire-go/turbo"

templ EditButton(href string) {
	<a
		href={ templ.SafeURL(href) }
		{ turbo.AttrFrame("_top")... }
		class="shrink-0 inline-flex items-center gap-1 rounded-md border border-gray-200 bg-white px-2 py-1 text-[11px] font-medium text-gray-600 hover:border-gray-900 hover:bg-gray-900 hover:text-white transition-colors"
	>
		<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M12 20h9"></path>
			<path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
		</svg>
		編集
	</a>
}
