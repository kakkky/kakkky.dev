package components

import (
	"strconv"
	"time"
	"github.com/kakkky/hotwire-go/turbo"
)

type FeedItemCardViewModel struct {
	Title       string
	Href        string
	PublishedAt time.Time
	Tags        []string

	IsSeries bool
	// 以下は IsSeries が trueの場合に有効
	ArticleCount int
	// SeriesStatus は domain.SeriesStatus の raw string ("published_ongoing" / "published_completed")
	SeriesStatus string
}

templ FeedItemCard(vm FeedItemCardViewModel) {
	if vm.IsSeries {
		@seriesCard(vm)
	} else {
		@articleCard(vm)
	}
}

templ articleCard(vm FeedItemCardViewModel) {
	<article class="group relative rounded-lg border border-gray-200 bg-white p-6 hover:border-gray-300 hover:bg-gray-50 transition-colors focus-within:ring-2 focus-within:ring-gray-900 focus-within:ring-offset-2">
		<div class="flex items-center gap-2 text-xs text-gray-500">
			<time datetime={ vm.PublishedAt.Format(time.RFC3339) }>{ vm.PublishedAt.Format("2006-01-02") }</time>
			<span class="inline-flex items-center rounded-full border border-gray-300 bg-white px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-gray-600">Article</span>
		</div>
		<h3 class="mt-2 text-lg font-medium text-gray-900">
			<a href={ templ.SafeURL(vm.Href) } { turbo.AttrFrame("_top")... } class="before:absolute before:inset-0 focus:outline-none group-hover:underline">
				{ vm.Title }
			</a>
		</h3>
		@tagList(vm.Tags)
	</article>
}

templ seriesCard(vm FeedItemCardViewModel) {
	<article class="group relative rounded-lg border border-gray-200 border-l-4 border-l-gray-900 bg-white p-6 hover:bg-gray-50 transition-colors focus-within:ring-2 focus-within:ring-gray-900 focus-within:ring-offset-2">
		<div class="flex items-center gap-2 text-xs text-gray-500">
			<time datetime={ vm.PublishedAt.Format(time.RFC3339) }>{ vm.PublishedAt.Format("2006-01-02") }</time>
			<span class="inline-flex items-center rounded-full border border-gray-900 bg-white px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-gray-900">Series</span>
			@SeriesStatusLabel(vm.SeriesStatus)
		</div>
		<div class="mt-2 flex items-start justify-between gap-4">
			<h3 class="text-lg font-medium text-gray-900">
				<a href={ templ.SafeURL(vm.Href) } { turbo.AttrFrame("_top")... } class="before:absolute before:inset-0 focus:outline-none group-hover:underline">
					{ vm.Title }
				</a>
			</h3>
			<span class="shrink-0 inline-flex items-center rounded-md bg-gray-900 px-2 py-0.5 text-xs text-white">
				+{ strconv.Itoa(vm.ArticleCount) } articles
			</span>
		</div>
		@tagList(vm.Tags)
	</article>
}

templ tagList(names []string) {
	if len(names) > 0 {
		<div class="mt-4 flex flex-wrap gap-1.5">
			for _, name := range names {
				@TagBadge(name)
			}
		</div>
	}
}
