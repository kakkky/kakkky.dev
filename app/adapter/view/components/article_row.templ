package components

import (
	"time"

	"github.com/kakkky/hotwire-go/turbo"
)

type ArticleRowViewModel struct {
	Title       string
	Status      string
	CreatedAt   time.Time
	Href        string
	EditHref    string
	SeriesTitle string
	SeriesHref  string
}

templ ArticleRow(vm ArticleRowViewModel) {
	<div class="flex items-center gap-3 py-2 text-sm">
		<div class="w-24 shrink-0">
			@ArticleStatusLabel(vm.Status)
		</div>
		<div class="flex-1 min-w-0">
			<a href={ templ.SafeURL(vm.Href) } { turbo.AttrFrame("_top")... } class="block truncate text-gray-900 hover:text-gray-600 hover:underline">
				{ vm.Title }
			</a>
			<div class="flex items-center gap-4 text-[11px] text-gray-400">
				<span>{ vm.CreatedAt.Format("2006-01-02") }</span>
				if vm.SeriesTitle != "" {
					<a href={ templ.SafeURL(vm.SeriesHref) } { turbo.AttrFrame("_top")... } class="inline-flex items-center gap-1 rounded-full border border-gray-200 bg-gray-50 px-2 py-[1px] text-gray-500 hover:text-gray-700 hover:border-gray-300">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" fill="currentColor" class="h-3.5 w-3.5"><path d="M384-408h192v-72H384v72Zm0-120h336v-72H384v72Zm0-120h336v-72H384v72Zm-72 408q-29.7 0-50.85-21.15Q240-282.3 240-312v-480q0-29.7 21.15-50.85Q282.3-864 312-864h480q29.7 0 50.85 21.15Q864-821.7 864-792v480q0 29.7-21.15 50.85Q821.7-240 792-240H312Zm0-72h480v-480H312v480ZM168-96q-29.7 0-50.85-21.15Q96-138.3 96-168v-552h72v552h552v72H168Zm144-696v480-480Z"/></svg>
						<span class="truncate max-w-[12rem]">{ vm.SeriesTitle }</span>
					</a>
				}
			</div>
		</div>
		@EditButton(vm.EditHref)
	</div>
}
