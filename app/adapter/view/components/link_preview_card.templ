package components

type LinkPreviewCardViewModel struct {
	URL         string
	Host        string
	Title       string
	Description string
	Image       string
}

templ LinkPreviewCard(vm LinkPreviewCardViewModel) {
	<a
		href={ templ.SafeURL(vm.URL) }
		target="_blank"
		rel="noopener noreferrer"
		class="group flex h-36 items-stretch overflow-hidden rounded-lg border border-gray-200 bg-white no-underline transition-colors hover:border-gray-400 hover:bg-gray-50"
	>
		<div class="flex min-w-0 flex-1 flex-col justify-between gap-2 p-4">
			<div class="flex min-w-0 flex-col gap-1">
				if vm.Title != "" {
					<div class="line-clamp-2 text-base font-semibold text-gray-900 group-hover:text-black">
						{ vm.Title }
					</div>
				} else {
					<div class="line-clamp-2 break-all text-base font-semibold text-gray-900">
						{ vm.URL }
					</div>
				}
				if vm.Description != "" {
					<div class="line-clamp-2 text-xs text-gray-600">
						{ vm.Description }
					</div>
				}
			</div>
			<div class="flex min-w-0 items-center gap-1 text-xs text-gray-500">
				if vm.Host != "" {
					<img
						src={ "https://www.google.com/s2/favicons?domain=" + vm.Host + "&sz=32" }
						alt=""
						style="display:inline-block;margin:0;height:1rem;width:1rem;min-width:1rem;max-width:none;border-radius:0;"
					/>
					<span class="truncate">{ vm.Host }</span>
				} else {
					<span class="truncate">{ vm.URL }</span>
				}
			</div>
		</div>
		if vm.Image != "" {
			<div class="shrink-0 self-stretch overflow-hidden bg-gray-100 w-28 sm:w-[275px]">
				<img
					src={ vm.Image }
					alt=""
					loading="lazy"
					style="display:block;margin:0;height:100%;width:100%;max-width:none;border-radius:0;object-fit:cover;"
				/>
			</div>
		}
	</a>
}
