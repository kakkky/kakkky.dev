package components

type LinkPreviewViewModel struct {
	URL         string
	Host        string
	Title       string
	Description string
	Image       string
}

templ LinkPreview(vm LinkPreviewViewModel) {
	<a
		href={ templ.SafeURL(vm.URL) }
		target="_blank"
		rel="noopener noreferrer"
		class="not-prose group flex overflow-hidden rounded-lg border border-gray-200 bg-white transition-colors hover:border-gray-400 hover:bg-gray-50"
	>
		<div class="flex min-w-0 flex-1 flex-col justify-between p-4">
			if vm.Title != "" {
				<div class="line-clamp-2 text-sm font-semibold text-gray-900 group-hover:text-black">
					{ vm.Title }
				</div>
			} else {
				<div class="truncate text-sm font-semibold text-gray-900">
					{ vm.URL }
				</div>
			}
			<div class="mt-2 truncate text-xs text-gray-500">
				if vm.Host != "" {
					<img
						src={ "https://www.google.com/s2/favicons?domain=" + vm.Host + "&sz=32" }
						alt=""
						class="mr-1 inline-block h-4 w-4 align-text-bottom"
					/>
					{ vm.Host }
				} else {
					{ vm.URL }
				}
			</div>
		</div>
		if vm.Image != "" {
			<div class="hidden shrink-0 sm:block">
				<img
					src={ vm.Image }
					alt=""
					loading="lazy"
					class="h-full w-40 object-cover"
				/>
			</div>
		}
	</a>
}

templ LinkPreviewFrame(frameID string, vm LinkPreviewViewModel) {
	<turbo-frame id={ frameID }>
		@LinkPreview(vm)
	</turbo-frame>
}
