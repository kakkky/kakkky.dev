package components

templ NewButton(href, label string, primary bool) {
	if primary {
		<a
			href={ templ.SafeURL(href) }
			class="inline-flex items-center gap-1.5 rounded-md border border-gray-900 bg-gray-900 px-3 py-1.5 text-xs font-medium text-white shadow-sm hover:bg-white hover:text-gray-900 transition-colors"
		>
			@plusIcon()
			{ label }
		</a>
	} else {
		<a
			href={ templ.SafeURL(href) }
			class="inline-flex items-center gap-1.5 rounded-md border border-gray-900 bg-white px-3 py-1.5 text-xs font-medium text-gray-900 hover:bg-gray-900 hover:text-white transition-colors"
		>
			@plusIcon()
			{ label }
		</a>
	}
}

templ plusIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<line x1="12" y1="5" x2="12" y2="19"></line>
		<line x1="5" y1="12" x2="19" y2="12"></line>
	</svg>
}
