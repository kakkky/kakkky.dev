package components

templ ArticleStatusLabel(status string) {
	switch status {
		case "draft":
			<span class="inline-flex items-center gap-1 rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-amber-700">
				<span class="h-1.5 w-1.5 rounded-full bg-amber-500" aria-hidden="true"></span>
				Draft
			</span>
		case "published":
			<span class="inline-flex items-center gap-1 rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-emerald-700">
				<span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
				Published
			</span>
	}
}
