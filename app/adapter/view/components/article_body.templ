package components

import "time"

type ArticleBodyViewModel struct {
	Title       string
	PublishedAt time.Time
	Tags        []string
	BodyHTML    string
}

templ ArticleBody(vm ArticleBodyViewModel) {
	<article class="min-w-0">
		<header class="mb-6">
			<h1 class="text-3xl font-bold tracking-tight text-gray-900">{ vm.Title }</h1>
			<div class="mt-3 text-sm text-gray-500">
				<time datetime={ vm.PublishedAt.Format(time.RFC3339) }>
					{ vm.PublishedAt.Format("2006-01-02") }
				</time>
			</div>
			if len(vm.Tags) > 0 {
				<div class="mt-4 flex flex-wrap gap-1.5">
					for _, name := range vm.Tags {
						@TagBadge(name, nil)
					}
				</div>
			}
		</header>
		<hr class="mb-8 border-gray-200"/>
		<div class="article-body">
			@templ.Raw(vm.BodyHTML)
		</div>
	</article>
}
