package pages

import (
	"github.com/kakkky/kakkky.dev/adapter/view/components"
	"github.com/kakkky/kakkky.dev/adapter/view/layout"
)

type NewArticleViewModel struct {
	ExistingTags []components.TagViewModel
}

templ NewArticle(vm NewArticleViewModel) {
	@layout.Base("New Article", "max-w-none") {
		<section class="mx-auto max-w-2xl py-8 px-4">
			<h1 class="text-xl font-semibold tracking-tight text-gray-900 mb-6">New Article</h1>
			<form method="post" action="/admin/articles" class="flex flex-col gap-6">
				<label class="flex flex-col gap-2">
					<span class="text-sm font-medium text-gray-700">Title</span>
					<input
						type="text"
						name="title"
						maxlength="100"
						required
						placeholder="タイトル"
						class="rounded-md border border-gray-300 bg-white px-3 py-2 text-sm focus:border-gray-900 focus:outline-none"
					/>
				</label>
				@components.TagInput(components.TagInputViewModel{
					ExistingTags: vm.ExistingTags,
				})
				<button
					type="submit"
					class="self-start inline-flex items-center gap-1.5 rounded-md border border-gray-900 bg-gray-900 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-white hover:text-gray-900 transition-colors"
				>
					作成
				</button>
			</form>
		</section>
	}
}
