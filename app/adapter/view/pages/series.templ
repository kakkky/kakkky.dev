package pages

import (
	"strconv"
	"time"

	"github.com/kakkky/hotwire-go/turbo"
	"github.com/kakkky/kakkky.dev/adapter/view/components"
	"github.com/kakkky/kakkky.dev/adapter/view/layout"
)

type SeriesArticleViewModel struct {
	Position    int
	Title       string
	Href        string
	PublishedAt time.Time
	Tags        []string
}

type SeriesViewModel struct {
	Title       string
	Description string
	Status      string
	PublishedAt time.Time
	Tags        []string
	Articles    []SeriesArticleViewModel
}

templ Series(vm SeriesViewModel) {
	@layout.Base(vm.Title, "max-w-4xl", nil) {
		<section class="py-16">
			@seriesHeader(vm)
			<hr class="mb-8 border-gray-200"/>
			@seriesArticleList(vm.Articles)
		</section>
	}
}

templ seriesHeader(vm SeriesViewModel) {
	<header class="mb-10">
		<div class="flex items-center gap-2 text-xs text-gray-500">
			<span class="inline-flex items-center rounded-full border border-gray-900 bg-white px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-gray-900">Series</span>
			@components.SeriesStatusLabel(vm.Status)
		</div>
		<h1 class="mt-3 text-3xl font-bold tracking-tight text-gray-900">{ vm.Title }</h1>
		if vm.Description != "" {
			<p class="mt-4 whitespace-pre-line text-gray-600">{ vm.Description }</p>
		}
		<div class="mt-6 flex items-center gap-2 text-sm text-gray-500">
			<time datetime={ vm.PublishedAt.Format(time.RFC3339) }>
				{ vm.PublishedAt.Format("2006-01-02") }
			</time>
			<span aria-hidden="true">·</span>
			<span>{ strconv.Itoa(len(vm.Articles)) } articles</span>
		</div>
		if len(vm.Tags) > 0 {
			<div class="mt-4 flex flex-wrap gap-1.5">
				for _, name := range vm.Tags {
					@components.TagBadge(name, nil)
				}
			</div>
		}
	</header>
}

templ seriesArticleList(articles []SeriesArticleViewModel) {
	if len(articles) == 0 {
		<p class="text-sm text-gray-500">まだ article が ありません</p>
	} else {
		<ol class="divide-y divide-gray-200">
			for _, a := range articles {
				<li>
					@seriesArticle(a)
				</li>
			}
		</ol>
	}
}

templ seriesArticle(a SeriesArticleViewModel) {
	<a href={ templ.SafeURL(a.Href) } { turbo.AttrFrame("_top")... } class="group flex items-start gap-4 py-5 hover:bg-gray-50 px-2 -mx-2 rounded-md transition-colors">
		<span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gray-900 text-xs font-semibold text-white">
			{ strconv.Itoa(a.Position) }
		</span>
		<div class="min-w-0 flex-1">
			<h2 class="text-base font-medium text-gray-900 group-hover:underline">
				{ a.Title }
			</h2>
			<div class="mt-1 text-xs text-gray-500">
				<time datetime={ a.PublishedAt.Format(time.RFC3339) }>
					{ a.PublishedAt.Format("2006-01-02") }
				</time>
			</div>
			if len(a.Tags) > 0 {
				<div class="mt-3 flex flex-wrap gap-1.5">
					for _, name := range a.Tags {
						@components.TagBadge(name, nil)
					}
				</div>
			}
		</div>
	</a>
}
