package pages

import (
	"strconv"

	"github.com/kakkky/kakkky.dev/adapter/view/components"
	"github.com/kakkky/kakkky.dev/adapter/view/layout"
	"github.com/kakkky/kakkky.dev/adapter/view/partials"
	"github.com/kakkky/kakkky.dev/assets/js"
)

type DashboardViewModel struct {
	Articles      partials.ArticlesListViewModel
	ArticlesTotal int
	Series        partials.SeriesListViewModel
	SeriesTotal   int
	PublicBaseURL string
}

templ Dashboard(vm DashboardViewModel) {
	@layout.Base("Dashboard", "max-w-none", vm.PublicBaseURL, nil, js.EChartsScript()) {
		<section class="flex flex-col gap-4 py-4 md:pt-6 md:pb-8 md:px-4 lg:px-8">
			@dashboardHeader()
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				@partials.SiteAnalyticsLazyFrame()
				@partials.ArticlesAnalyticsLazyFrame()
			</div>
			<div class="grid grid-cols-1 md:grid-cols-12 gap-4">
				<div class="md:col-span-6 rounded-lg border border-gray-200 bg-white p-4 h-80 md:h-[32rem] flex flex-col min-h-0">
					@panelHeader("Articles", vm.ArticlesTotal)
					<div class="mt-3 flex-1 min-h-0 overflow-y-auto">
						@partials.ArticlesList(vm.Articles)
					</div>
				</div>
				<div class="md:col-span-6 rounded-lg border border-gray-200 bg-white p-4 h-80 md:h-[32rem] flex flex-col min-h-0">
					@panelHeader("Series", vm.SeriesTotal)
					<div class="mt-3 flex-1 min-h-0 overflow-y-auto">
						@partials.SeriesList(vm.Series)
					</div>
				</div>
			</div>
		</section>
	}
}

templ dashboardHeader() {
	<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
		<h1 class="text-xl font-semibold tracking-tight text-gray-900 leading-none">Dashboard</h1>
		<div class="hidden md:flex flex-wrap items-center gap-2">
			@components.NewButton("/articles/new", "New Article", false)
			@components.NewButton("/series/new", "New Series", true)
		</div>
	</div>
}

templ panelHeader(title string, count int) {
	<div class="flex items-baseline justify-between">
		<h2 class="text-sm font-semibold tracking-tight text-gray-900">{ title }</h2>
		<span class="text-xs font-semibold tabular-nums text-gray-600">{ strconv.Itoa(count) } 件</span>
	</div>
}

