package pages

import (
	"github.com/kakkky/kakkky.dev/adapter/view/components"
	"github.com/kakkky/kakkky.dev/adapter/view/layout"
	"github.com/kakkky/kakkky.dev/adapter/view/partials"
)

type FeedViewModel struct {
	List      partials.FeedItemListViewModel
	TagFilter components.TagFilterAreaViewModel
}

templ Feed(vm FeedViewModel) {
	@layout.Base("Feed", "max-w-4xl") {
		<section id="feed" class="py-16">
			<div class="flex items-baseline justify-between">
				<h2 class="text-2xl font-semibold tracking-tight">Feed</h2>
				<p class="text-xs text-gray-500">Articles &amp; Series</p>
			</div>
			@components.TagFilterArea(vm.TagFilter)
			<div class="mt-8">
				@partials.FeedItemList(vm.List)
			</div>
		</section>
	}
}
