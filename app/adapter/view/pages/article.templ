package pages

import (
	"time"

	"github.com/kakkky/kakkky.dev/adapter/view"
	"github.com/kakkky/kakkky.dev/adapter/view/components"
	"github.com/kakkky/kakkky.dev/adapter/view/layout"
	"github.com/kakkky/kakkky.dev/assets/js"
)

type ArticleViewModel struct {
	Title       string
	PublishedAt time.Time
	Tags        []string
	Body        string
	Outline    []*view.OutlineNode
	InSeriesRef    *SeriesRefViewModel
}

type SeriesRefViewModel struct {
	Slug                   string
	Title                  string
	Status                 string
	CurrentArticlePosition int
	PrevArticleRef         *SeriesNeighborArticleRefViewModel
	NextArticleRef         *SeriesNeighborArticleRefViewModel
}

type SeriesNeighborArticleRefViewModel struct {
	Slug     string
	Title    string
	Position int
}

templ Article(vm ArticleViewModel) {
	@layout.Base(vm.Title, "max-w-7xl", []string{js.OutlineDialogController.Path}) {
		// モバイル表示の場合目次ヘッダーを表示する
		<div class="contents xl:hidden">
			@components.ArticleOutlineHeader(vm.Outline)
		</div>
		<div class="grid grid-cols-1 gap-10 py-12 xl:grid-cols-[240px_minmax(0,1fr)_240px]">
			<div class="hidden xl:block" aria-hidden="true"></div>
			<div>
				if vm.InSeriesRef != nil {
					// TODO: series banner (series: {InSeriesRef.Title})
				}
				@components.ArticleBody(components.ArticleBodyViewModel{
					Title:       vm.Title,
					PublishedAt: vm.PublishedAt,
					Tags:        vm.Tags,
					BodyHTML:    vm.Body,
				})
				if vm.InSeriesRef != nil && (vm.InSeriesRef.PrevArticleRef != nil || vm.InSeriesRef.NextArticleRef != nil) {
					// TODO: prev / next navigation
				}
			</div>
			<div class="hidden xl:block">
				@components.ArticleSidebar(components.ArticleSidebarViewModel{
					Outline: vm.Outline,
				})
			</div>
		</div>
	}
}
