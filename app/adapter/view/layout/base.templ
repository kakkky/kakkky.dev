package layout

import "github.com/kakkky/hotwire-go/stimulus"
import "github.com/kakkky/hotwire-go/turbo"
import "github.com/kakkky/kakkky.dev/adapter/view"
import "github.com/kakkky/kakkky.dev/assets/js"
import "fmt"

templ shell(subTitle, maxW string) {
	<!DOCTYPE html>
	<html lang="ja">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ pageTitle(subTitle) }</title>
			<link rel="stylesheet" href="/assets/main.css"/>
			@turbo.ScriptImport()
			@stimulus.ScriptLoad(js.ControllerPaths...)
		</head>
		<body class="min-h-screen bg-white text-gray-900 font-sans antialiased">
			@Header()
			<div id="flash" class="fixed top-4 left-1/2 -translate-x-1/2 z-50 flex flex-col gap-2"></div>
			<main class={ "mx-auto " + maxW + " px-6" }>
				{ children... }
			</main>
		</body>
	</html>
}

templ Base(subTitle string) {
	@shell(subTitle, "max-w-4xl") {
		{ children... }
	}
}

templ BaseWide(subTitle string) {
	@shell(subTitle, "max-w-7xl") {
		{ children... }
	}
}

func pageTitle(subTitle string) string {
	if subTitle == "" {
		return view.ServiceName
	}
	return fmt.Sprintf("%s | %s",view.ServiceName, subTitle)
}
