package partials

import (
	"html/template"
	"strconv"

	"github.com/kakkky/hotwire-go/turbo"

	"github.com/kakkky/kakkky.dev/adapter/view/components"
)

const ArticlesAnalyticsID = "articles-analytics"

type ArticlesAnalyticsViewModel struct {
	RangeKey string // "7d" / "30d" / "90d"
	Items    []ArticleAnalyticsRow
}

type ArticleAnalyticsRow struct {
	Title         string
	Href          string
	Users         int64
	PageViews     int64
	TrendLineHTML template.HTML
}

templ ArticlesAnalyticsLazyFrame() {
	@turbo.Frame(
		ArticlesAnalyticsID,
		turbo.AttrSrc("/dashboard?panel=articles_analytics&range="+components.AnalyticsRange7d),
		turbo.AttrLoadingLazy(),
	) {
		@analyticsFrameSkeleton()
	}
}

templ ArticlesAnalytics(vm ArticlesAnalyticsViewModel) {
	@turbo.Frame(ArticlesAnalyticsID) {
		<section class="rounded-lg border border-gray-200 bg-white p-4 flex flex-col h-80 md:h-[32rem] min-h-0">
			<header class="flex items-baseline justify-between mb-3">
				<h2 class="text-sm font-semibold">Articles Analytics</h2>
				@components.AnalyticsRangeGroup(vm.RangeKey, "articles_analytics")
			</header>
			<div class="flex-1 min-h-0 overflow-y-auto">
				<table class="w-full text-sm table-fixed">
					<thead class="text-xs text-gray-600 sticky top-0 bg-white">
						<tr class="border-b border-gray-200">
							<th class="text-left py-2">Title</th>
							<th class="text-right py-2 w-12">PV</th>
							<th class="text-right py-2 w-12">UU</th>
							<th class="text-left py-2 pl-4 w-64">推移</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-100">
						for _, item := range vm.Items {
							<tr>
								<td class="py-2 truncate">
									<a class="underline" href={ templ.URL(item.Href) }>{ item.Title }</a>
								</td>
								<td class="py-2 text-right tabular-nums">{ strconv.FormatInt(item.PageViews, 10) }</td>
								<td class="py-2 text-right tabular-nums">{ strconv.FormatInt(item.Users, 10) }</td>
								<td class="py-2 pl-4">
									@templ.Raw(item.TrendLineHTML)
								</td>
							</tr>
						}
						if len(vm.Items) == 0 {
							<tr>
								<td colspan="4" class="py-4 text-center text-xs text-gray-500">no data</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>
	}
}
